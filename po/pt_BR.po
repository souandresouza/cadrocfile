# ── Mount errors ─────────────────────────────────────────────────────────────
msgid "This drive needs your password to mount, but no authentication agent is running, so nothing can ask for it."
msgstr "Esta unidade precisa da sua senha para montar, mas nenhum agente de autenticação está em execução, então nada pode pedi-la."

msgid "Administrator access is required to repair this volume."
msgstr "Acesso de administrador é necessário para reparar esta unidade."

msgid "Administrator access is required to force this mount."
msgstr "Acesso de administrador é necessário forçar esta montagem."

msgid "ntfsfix is not installed. On Arch it comes from the ntfsprogs package."
msgstr "ntfsfix não está instalado. No Arch ele vem do pacote ntfsprogs."

msgid "UDisks2 refused the mount options Cadrocfile asked for. This is a bug in Cadrocfile, not a problem with the drive."
msgstr "UDisks2 recusou as opções de montagem que o Cadrocfile solicitou. Isso é um bug no Cadrocfile, não um problema com a unidade."

